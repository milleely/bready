// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id                String             @id @default(cuid())
  clerkId           String             @unique // Clerk user ID (household owner)
  name              String             // Household name
  users             User[]             // Household members (up to 4)
  budgets           Budget[]           // Household budgets
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String?            // Optional: only owner has Clerk email
  avatar            String?
  color             String             // For UI theming
  isOwner           Boolean            @default(false) // True for household owner
  householdId       String             // Foreign key to Household
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  createdAt         DateTime           @default(now())

  @@index([householdId])
}

model Expense {
  id                  String            @id @default(cuid())
  amount              Float
  category            String
  description         String
  date                DateTime
  isShared            Boolean           @default(false)
  receiptUrl          String?           // Optional: URL/path to receipt image
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpenseId  String?           // Optional: ID of recurring expense that generated this
  recurringExpense    RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([category])
  @@index([date])
  @@index([recurringExpenseId])
  // 🚀 PERFORMANCE: Composite indexes for Net Worth dashboard queries
  @@index([userId, date, isShared, category]) // User expenses with date range + category
  @@index([isShared, date, category])          // Shared expenses with date range + category
  @@index([isShared])                          // Standalone index for shared expense queries (settlements)
}

model Budget {
  id          String    @id @default(cuid())
  category    String
  amount      Float
  month       String    // Format: "YYYY-MM"
  userId      String?   // Optional: null means shared budget for all users in household
  householdId String    // Link to household for proper isolation
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([category, month, userId, householdId])
  @@index([month])
  @@index([userId])
  @@index([householdId])
  @@index([householdId, category, month])  // Composite index for budget threshold lookups
}

model RecurringExpense {
  id          String    @id @default(cuid())
  amount      Float
  category    String
  description String
  frequency   String    // "monthly", "weekly", "yearly"
  dayOfMonth  Int?      // For monthly: 1-31 (day of month to create expense)
  dayOfWeek   Int?      // For weekly: 0-6 (0=Sunday)
  monthOfYear Int?      // For yearly: 1-12
  isShared    Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nextDate    DateTime  // Next date to create the expense
  isActive    Boolean   @default(true)
  expenses    Expense[] // Expenses generated from this recurring expense
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([nextDate])
  @@index([isActive])
}

model Settlement {
  id          String   @id @default(cuid())
  fromUserId  String   // User who owes money
  toUserId    String   // User who receives money
  amount      Float    // Amount paid
  date        DateTime @default(now()) // When the payment was made
  month       String   // Format: "YYYY-MM" - which month this settlement applies to
  note        String?  // Optional note about the payment
  createdAt   DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([month])
  @@index([date])
  // 🚀 PERFORMANCE: Composite indexes for month + user queries
  @@index([month, fromUserId])
  @@index([month, toUserId])
}

// ============================================================================
// NET WORTH TRACKING MODELS
// ============================================================================

model UserPin {
  id        String   @id @default(cuid())
  userId    String   @unique
  pin       String   // Hashed using bcrypt - NEVER store plaintext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  month     String   @default("2025-11") // Format: "YYYY-MM" - tracks which month this data belongs to
  name      String   // "Primary Salary", "Freelance", "Rental Income", etc.
  amount    Float    // Amount per period
  frequency String   // "biweekly", "monthly", "annual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, name]) // Prevent duplicate entries for same source in same month
  @@index([userId])
  @@index([month])
}

model Asset {
  id        String   @id @default(cuid())
  userId    String
  month     String   @default("2025-11") // Format: "YYYY-MM" - tracks which month this data belongs to
  category  String   // "cash", "investments", "property", "vehicles", "other"
  name      String   // "Chase Checking", "401(k)", "Primary Home", etc.
  value     Float    // Current value
  notes     String?  // Optional notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, name]) // Prevent duplicate entries for same asset in same month
  @@index([userId])
  @@index([month])
  @@index([category])
}

model Liability {
  id             String   @id @default(cuid())
  userId         String
  month          String   @default("2025-11") // Format: "YYYY-MM" - tracks which month this data belongs to
  category       String   // "credit_card", "student_loan", "mortgage", "auto_loan", "personal_loan", "other"
  name           String   // "Chase Freedom", "Navient Student Loan", etc.
  balance        Float    // Current balance owed
  interestRate   Float?   // APR (optional)
  minimumPayment Float?   // Monthly minimum payment (optional)
  notes          String?  // Optional notes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month, name]) // Prevent duplicate entries for same liability in same month
  @@index([userId])
  @@index([month])
  @@index([category])
}

model MonthlyExpenseOverride {
  id          String   @id @default(cuid())
  userId      String   @unique
  amount      Float    // Manual override amount
  useOverride Boolean  @default(false) // Whether to use override instead of auto-calc
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model NotificationPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique

  // Budget alerts
  budgetAlertsEnabled       Boolean  @default(true)
  budgetAlertThresholds     String   @default("75,90,100") // CSV: "75,90,100"

  // Settlement reminders
  settlementRemindersEnabled Boolean @default(true)
  settlementReminderDays    String   @default("first,last") // CSV: "first", "last", "first,last"

  // Recurring expense reminders
  recurringRemindersEnabled Boolean  @default(true)
  recurringReminderDays     String   @default("1,3,7") // CSV: "1", "3", "7", "1,3,7"

  // Delivery preferences
  emailEnabled              Boolean  @default(true)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([userId])
}
